# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# --- Bot identity ---
BOT_NAME=Asheyrix
PREFIX=.

# --- Owner(s) ---
# Comma-separated, full international format, digits only (no +, no spaces)
# Example: 2348012345678,15551234567
OWNER_NUMBERS=

# --- Bot mode ---
# public  = anyone can use commands
# private = only owner can use commands
# self    = bot only responds to messages sent from the owner's own account
BOT_MODE=private

# --- Login method ---
# qr      = scan a QR code (default)
# pairing = use a WhatsApp pairing code instead of QR
LOGIN_METHOD=qr

# Required only when LOGIN_METHOD=pairing. Full international format, digits only.
PAIRING_NUMBER=

# --- Session / auth ---
AUTH_DIR=./auth

# --- Logging ---
# fatal, error, warn, info, debug, trace
LOG_LEVEL=info
PRETTY_LOGS=true

# --- Connection notifications ---
# Sends a message to the owner(s) every time the bot connects/reconnects.
SEND_CONNECT_NOTIFICATION=true

# --- Menu ---
# Optional path to an image shown alongside .menu (relative to project root).
# Leave blank to send text-only. Supported: jpg/jpeg/png. Keep it small (<2MB).
MENU_IMAGE=./assets/menu-banner.jpg

# --- View Once unlocking ---
# Both triggers are owner-only and always deliver to your own DM — nothing
# is ever sent back into the chat the media came from.
# Reply this word (no prefix) to a View Once message to unlock it.
VIEW_ONCE_TRIGGER_WORD=waw
# React with this emoji to unlock it. Less reliable than the reply trigger:
# a reaction gives the bot no media key, so it only works if the bot already
# cached that message (within the last 30 minutes).
VIEW_ONCE_TRIGGER_EMOJI=👀

# --- AI (Phase 7) ---
# Master switch. Every AI command declines politely while this is false.
AI_ENABLED=false

# Which service to talk to. One of:
#   anthropic | openai | gemini | groq | openrouter | deepseek | custom
# "custom" points at any OpenAI-compatible endpoint (Ollama, LM Studio,
# vLLM, Together, Mistral) — set AI_BASE_URL to its /v1 root.
AI_PROVIDER=anthropic

# Your API key. This is the one secret the bot needs beyond the WhatsApp
# session itself. It is read ONLY from here: no command can print it and
# nothing writes it to database/settings.json.
AI_API_KEY=

# Leave blank to use the provider's default model.
AI_MODEL=

# Required only when AI_PROVIDER=custom. Include the /v1 path.
# Example: http://localhost:11434/v1
AI_BASE_URL=

# Generation settings. Temperature 0 is deterministic, 2 is chaotic.
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# How many past turns the bot remembers per person, per chat. 0 disables
# memory entirely (every message starts fresh).
AI_MAX_HISTORY=6

# Give up on a slow provider after this many seconds.
AI_TIMEOUT_SECONDS=60

# Largest image the bot will send to a vision model, in megabytes.
AI_MAX_IMAGE_MB=5

# Language .translate uses when you don't name one.
AI_DEFAULT_TRANSLATE_LANGUAGE=English

# --- PDF / document tools ---
# Used by .pdfsummary, .askpdf, .translatepdf, .compresspdf, .mergepdf,
# .splitpdf and .ocr. No API key of their own — the text ones reuse the AI
# settings above, and the file ones run entirely on your machine.
#
# Optional system tools that make these better if installed:
#   poppler-utils  -> lets .ocr and .pdfsummary read SCANNED PDFs
#   ghostscript    -> much stronger .compresspdf (falls back to qpdf, then
#                     a pure-JS re-save, both of which save far less)

# Stop reading a PDF after this many pages.
PDF_MAX_PAGES=100
# OCR is slow (a render + a Tesseract pass per page), so scans get a much
# lower ceiling than text PDFs.
PDF_OCR_MAX_PAGES=10
# Characters of PDF text sent to the model per request. ~12k chars ≈ 3k
# tokens, which fits every provider's context window.
PDF_MAX_CHARS_FOR_AI=12000
# How hard .compresspdf squeezes by default: low | medium | high
PDF_COMPRESS_QUALITY=medium
# Most files .splitpdf will send before telling you to pick a range instead,
# so a 300-page PDF can't flood a chat with 300 documents.
PDF_MAX_SPLIT_OUTPUTS=10

# --- AI image generation ---
# Powers .genimage, .editimage, .removebg, .logo, .poster, .avatar,
# .wallpaper and ".sticker <prompt>".
#
# Which service to draw with. One of:
#   pollinations | openai | gemini | stability
# "pollinations" is the default because it needs NO account and NO key, so
# the image commands work on a fresh install. It is slower and lower
# fidelity than the paid options, and it CANNOT edit images — .editimage
# and .removebg need one of the others (or REMOVEBG_API_KEY below).
IMAGE_PROVIDER=pollinations

# Only needed for openai / gemini / stability. Like AI_API_KEY, this is read
# only from here: no command can print it and nothing writes it to
# database/settings.json.
#
# Reuse shortcut: leave this blank and, if IMAGE_PROVIDER matches your
# AI_PROVIDER above, the bot uses AI_API_KEY automatically. So
# AI_PROVIDER=gemini + IMAGE_PROVIDER=gemini needs only the one key.
IMAGE_API_KEY=

# Leave blank to use the provider's default model.
#   openai    -> gpt-image-1
#   gemini    -> gemini-2.5-flash-image-preview
#   stability -> core
IMAGE_MODEL=

# Override the provider's API root. Rarely needed.
IMAGE_BASE_URL=

# Image models are slower than text models — give them room.
IMAGE_TIMEOUT_SECONDS=120

# Largest image the bot will accept as input to .editimage / .removebg /
# .enhance / .upscale, in megabytes.
IMAGE_MAX_MB=10

# Optional. A dedicated remove.bg key (https://www.remove.bg/api). When set,
# .removebg uses it instead of prompting a general image model, which gives
# noticeably cleaner edges around hair and transparency. Without it,
# .removebg falls back to your IMAGE_PROVIDER — and does not work at all on
# pollinations.
REMOVEBG_API_KEY=

# Note: .enhance and .upscale are pure ffmpeg. They need no key and no
# provider, and never send your image off the machine.

# --- Downloaders ---
# Maximum file size any downloader command will accept, in megabytes.
# Downloads are aborted mid-stream the instant this is exceeded.
MAX_DOWNLOAD_MB=50

# Optional — only required if you want .spotify to support text search
# (e.g. ".spotify shape of you"). Get these free at
# https://developer.spotify.com/dashboard. Without them, .spotify still
# works for pasted Spotify links (metadata only, no audio).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Music (all also changeable at runtime with .config music.<key> <value>) ---
MUSIC_ENABLED=true
MUSIC_DEFAULT_QUALITY=medium          # low | medium | high
MUSIC_MAX_FILE_SIZE_MB=50
MUSIC_MAX_DURATION=600                # seconds
MUSIC_MAX_CONCURRENT=2
MUSIC_AUTO_LINK_DETECTION=false       # auto-download YouTube/TikTok/IG/FB/X links

# --- PDF / document tools ---
# Pages read from a PDF before extraction stops. Beyond this the bot tells
# you the answer covers only part of the document rather than pretending
# it read all 400 pages.
PDF_MAX_PAGES=100

# Scanned PDFs (no text layer) need a render + Tesseract pass per page,
# which is far slower, so they get a much lower ceiling.
PDF_OCR_MAX_PAGES=10

# Characters of PDF text sent to the model in one request.
# ~12000 chars is roughly 3k tokens — fits every provider's context window
# alongside the instruction and the answer.
PDF_MAX_CHARS_FOR_AI=12000

# How hard .compresspdf squeezes by default: low | medium | high
# (low = most aggressive / smallest file, high = barely lossy)
PDF_COMPRESS_QUALITY=medium

# Most individual page-files .splitpdf will send before telling you to pick
# a range instead, so nobody accidentally gets 200 documents in their chat.
PDF_MAX_SPLIT_OUTPUTS=10

# --- AI image generation ---
# Which service draws the pictures. One of:
#   pollinations | openai | gemini | stability
#
# "pollinations" is the default because it needs NO API key at all, so the
# image commands work on a fresh clone. It is a free public service, so it
# is slower and lower fidelity than the paid options, and it CANNOT edit
# images — .editimage and .removebg need one of the others (or REMOVEBG_API_KEY).
IMAGE_PROVIDER=pollinations

# Your image API key. Like AI_API_KEY, this is read ONLY from here: no
# command can print it and nothing writes it to database/settings.json.
#
# Leave blank when IMAGE_PROVIDER=pollinations. If you leave it blank and
# IMAGE_PROVIDER matches AI_PROVIDER, the bot reuses AI_API_KEY — so
# AI_PROVIDER=gemini + IMAGE_PROVIDER=gemini needs only the one key.
IMAGE_API_KEY=

# Leave blank to use the provider's default model.
#   openai    -> gpt-image-1
#   gemini    -> gemini-2.5-flash-image-preview
#   stability -> core
IMAGE_MODEL=

# Override the provider's API root. Only needed for a proxy or a
# self-hosted compatible endpoint.
IMAGE_BASE_URL=

# Give up on a slow image provider after this many seconds. Image
# generation is much slower than text, hence the larger default.
IMAGE_TIMEOUT_SECONDS=120

# Largest source image .editimage / .removebg / .enhance will accept, in MB.
IMAGE_MAX_MB=10

# Optional. A dedicated remove.bg key (https://www.remove.bg/api).
# When set, .removebg uses it instead of prompting a general image model —
# noticeably cleaner edges around hair and semi-transparent areas.
# Without it, .removebg falls back to the IMAGE_PROVIDER above.
REMOVEBG_API_KEY=
